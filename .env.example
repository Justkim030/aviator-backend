# Server Environment Variables
# Copy to .env and fill in your values

DATABASE_URL=postgresql://user:pass@host:port/db
JWT_SECRET=your-super-secret-jwt-key-here-min32chars
ADMIN_PHONE=254712345678
FRONTEND_URL=http://localhost:5173
PORT=3001

# SMS Configuration (TalkSasa)
TALKSASA_BEARER_TOKEN=Bearer your_talksasa_api_token_here
TALKSASA_SENDER_ID=SASA_SMS
DISABLE_SMS=false  # Set true to disable SMS

# Payment (Paystack for M-Pesa STK)
PAYSTACK_SECRET_KEY=sk_test_yourpaystacksecretkey

